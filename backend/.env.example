# Salin file ini jadi ".env" lalu isi sesuai environment kamu.

# --- Database ---
DATABASE_URL=postgresql://sibi_user:sibi_pass@localhost:5432/sibi_translator

# --- Model artifact ---
MODEL_PATH=app/models/artifacts/sibi_gcn_model_standalone.pt
DEVICE=cpu   # ganti "cuda" kalau server ada GPU

# --- CORS (origin frontend React, pisahkan dengan koma kalau lebih dari satu) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- App ---
APP_NAME=SIBI Translator API
ENVIRONMENT=development
